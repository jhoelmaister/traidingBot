{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Escritorio: Electron (main)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": [".", "--remote-debugging-port=9222"],
      "env": {
        "VITE_DEV_SERVER_URL": "http://localhost:5173"
      },
      "preLaunchTask": "vite: dev",
      "console": "integratedTerminal",
      "outputCapture": "std"
    },
    {
      "name": "Escritorio: renderer (Chrome DevTools)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src",
      "timeout": 30000
    },
    {
      "name": "Web: Chrome sobre Vite",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "vite: dev"
    }
  ],
  "compounds": [
    {
      "name": "Escritorio: main + renderer",
      "configurations": [
        "Escritorio: Electron (main)",
        "Escritorio: renderer (Chrome DevTools)"
      ],
      "stopAll": true
    }
  ]
}
